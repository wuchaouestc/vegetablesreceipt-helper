__pycache__/
*.py[cod]
*.pyo
.pytest_cache/

# ===== 构建产物 =====
build/
dist/

# ===== 工具/调试目录 =====
.setup/
.workbuddy/

# ===== 日志 =====
*.log
log/

# ===== 运行时缓存/输出 =====
ocr_cache/
output/
清理归档/

